# A2560Me: use the screen workstation provided by fVDI (or monochrome recovery).
screendev = 1
font_id = 1
standard_point = 10
medium_point = 9
small_point = 8
lang = en
# Plain widgets; no additional graphics drivers, fonts, gradients or textures.
gradients = 0
textures = 0
set_rsc_palette = false
naes_cookie = false
resource = xaaes.rsc
widgets = xaaeswdg.rsc
clipboard = u:/d/clipbrd/
accpath = u:/d/accs/
launchpath = u:/d/desktop/
shell = u:/d/desktop/desktop.prg
